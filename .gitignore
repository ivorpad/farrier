node_modules/
dist/
*.log
.DS_Store
tmp/

# Python bytecode
__pycache__/
*.py[cod]

# Tool caches. Each of these writes its own self-ignoring .gitignore, so they
# never showed up as untracked; naming them here keeps that from being the only
# thing standing between a cache and the repository.
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
**/.ruff_cache/
.fallow/

# farrier: local secrets
.env
.env.*
!.env.example
.farrier-staging/
eval-workspaces/

# Eval artifacts and planning notes stay local. Evaluation output was only
# incidentally ignored before, by the `*.log` rule above: a result.json in that
# tree would have been committed.
docs/evaluations/
docs/plans/
docs/PLAN.md
docs/decision-gate.md
docs/harness-model.md
prompt-exports/

# This repository's own harness context. AGENTS.md is farrier's generated
# output here, and CLAUDE.md carries working project notes; both are local.
# This rule is for farrier's own repository only: the harness farrier writes
# into a user's project deliberately does NOT ignore these files, since they
# are the point of the harness there.
AGENTS.md
CLAUDE.md

# Claude Code local session state
.claude/scheduled_tasks.lock
